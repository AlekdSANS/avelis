PORT=4000
NODE_ENV=development
DATABASE_URL=
CLIENT_ORIGIN=http://localhost:5174
SESSION_COOKIE_NAME=avelis_session
SESSION_TTL_DAYS=30
IMAGE_STORAGE_PROVIDER=local

# Production object storage (Cloudflare R2, AWS S3, or compatible service)
# R2 endpoint example: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public custom domain or public bucket URL, without a trailing slash
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false

# Structured logging and optional external exception/operation delivery
LOG_LEVEL=info
SERVICE_VERSION=development
OBSERVABILITY_WEBHOOK_URL=
# Protects /api/health/diagnostics in production
OBSERVABILITY_TOKEN=
